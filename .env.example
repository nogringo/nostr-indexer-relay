# Every variable is optional.

# Host port to expose the relay on
PORT=3334

# Public URL of the relay, e.g. wss://indexer.example.com/
# Used for NIP-42 challenges when an author publishes a protected list.
# RELAY_URL=

# Name of the relay (NIP-11 metadata)
# RELAY_NAME=Indexer relay

# Description of the relay (NIP-11 metadata)
# RELAY_DESCRIPTION=An indexer relay that stores NIP-65 relay lists (kind 10002) only.

# Optional icon URL exposed in NIP-11 metadata
# RELAY_ICON=https://example.com/icon.png

# Optional contact information exposed in NIP-11 metadata
# RELAY_CONTACT=npub...

# Optional hex-encoded pubkey of the relay operator, published in NIP-11 metadata
# RELAY_PUBKEY=

# Maximum query limit. A REQ for N authors needs at least N. (default: 2000)
# RELAY_MAX_LIMIT=2000
